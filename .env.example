# Server
NODE_ENV=development
PORT=3000

# WTO API - Each endpoint has its own API key
WTO_BASE_URL=https://api.wto.org
WTO_EPING_API_KEY=your_eping_api_key_here
WTO_QR_API_KEY=your_qr_api_key_here
WTO_TIMESERIES_API_KEY=your_timeseries_api_key_here
WTO_TFAD_API_KEY=your_tfad_api_key_here
WTO_CUSTOM_API_KEY=your_custom_api_key_here
GEMINI_API_KEY=your_custom_api_key_here

COMTRADE_API_KEY=your_custom_api_key_here
GCP_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
GCP_SERVICE_ACCOUNT_KEY_FILE=/absolute/path/to/service-account.json
CLASSIFY_BASE_URL=https://ue1-dev-com-run-genai-aec-backend-785788544283.us-east1.run.app
CLASSIFY_USER_EMAIL=dafnanicole2612@gmail.com


# Database
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exporta_facil
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=
